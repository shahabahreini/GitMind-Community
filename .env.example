# GitMind Environment Configuration Template
# Copy this file to .env.local and fill in your actual values

# =============================================================================
# Azure Application Insights Configuration (for telemetry)
# =============================================================================
APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=YOUR_INSTRUMENTATION_KEY_HERE;IngestionEndpoint=https://YOUR_REGION.in.applicationinsights.azure.com/;LiveEndpoint=https://YOUR_REGION.livediagnostics.monitor.azure.com/;ApplicationId=YOUR_APPLICATION_ID_HERE
AZURE_RESOURCE_GROUP=your-resource-group-name
AZURE_APP_INSIGHTS_NAME=your-app-insights-name
AZURE_LOCATION=your-azure-region

# =============================================================================
# Pro licensing
# =============================================================================
# No configuration lives here. GitMind Pro licenses are validated against
# https://gitmind-pro.com/api/v1 using the user's own license key as the HMAC
# credential — there is no API token or product ID to embed in the extension.

# =============================================================================
# Development/Production Settings
# =============================================================================
NODE_ENV=production
EXTENSION_VERSION=4.2.1
GITMIND_ENCRYPTION_DEV_MODE=false

# =============================================================================
# Privacy and Telemetry Settings
# =============================================================================
TELEMETRY_RETENTION_DAYS=30
TELEMETRY_PRIVACY_MODE=true
TELEMETRY_MINIMAL_DATA=true
