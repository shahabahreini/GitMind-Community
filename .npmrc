# Disable npm version control warnings
engine-strict=false
# Suppress npm version warnings
fund=false
audit=false
# Prevent npm lockfile drift in the pnpm-managed repository.
package-lock=false
# Prefer locally cached packages when available.
prefer-offline=false
# Skip engine compatibility checks for vsce packaging
legacy-peer-deps=true
# Allow version mismatches during packaging
force=false
# Suppress warnings but show only errors
loglevel=error
